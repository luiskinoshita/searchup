# Copie estes nomes para Vercel > Project > Settings > Environment Variables

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://znacgonsmnzcotirmbfm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Maps (Places API New) — busca de lojas no raio. Secreta.
GOOGLE_MAPS_API_KEY=
# Máximo de buscas de lojas no Google por dia (padrão 150 = dentro da cota grátis)
GOOGLE_DAILY_LIMIT=150

# Rakuten (Application ID e Access Key "pk_...")
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=

# Opcional: Yahoo!ショッピング (deixe vazio se não tiver)
YAHOO_CLIENT_ID=

# Endereço público do site (o mesmo cadastrado em "Allowed websites" no Rakuten)
SITE_URL=https://searchup.vercel.app
